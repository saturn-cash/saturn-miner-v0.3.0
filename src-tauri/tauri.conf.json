{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saturn Miner",
  "version": "0.3.0",
  "identifier": "boats.saturn.miner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Saturn Miner",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "backgroundColor": "#141416",
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Desktop miner for Saturn Core",
    "longDescription": "Saturn Miner flies you around the Saturn system while you mine, and controls your Bitaxe hardware over your local network.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
